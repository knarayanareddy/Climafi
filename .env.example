# Nimbus Environment Variables

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=CLiMaFi1111111111111111111111111111111111111

# Devnet USDC mint — mint your own 6-decimal SPL token on devnet and paste its address here.
# (The mainnet USDC address EPjFWdd5... only exists on mainnet.)
NEXT_PUBLIC_USDC_MINT=

# Quote signing (server-side). Secret key of the Ed25519 keypair whose public key
# is set as `quote_signer` in initialize_config. Base58-encoded 64-byte secret.
QUOTE_SIGNER_SECRET_KEY=

# Optional: allow the signer to issue backdated quotes for the live settle demo.
# Leave unset/empty for production-safe behavior (future windows only).
# QUOTE_SIGNER_ALLOW_PAST=true

# Keys (never commit real keys)
ORACLE_AUTHORITY_KEYPAIR=./keys/oracle.json
QUOTE_SIGNER_KEYPAIR=./keys/quote_signer.json
ADMIN_KEYPAIR=./keys/admin.json

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/climafi
REDIS_URL=redis://localhost:6379

# API / frontend
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Alerting (optional)
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
