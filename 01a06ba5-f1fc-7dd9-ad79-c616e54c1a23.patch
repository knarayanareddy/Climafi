         let cfg = &ctx.accounts.config;
         require!(!cfg.paused, NimbusError::Paused);
 
+        // Account binding: the quote is bound to a specific buyer at signing
+        // time. Reject any quote whose buyer differs from the transaction
+        // signer, so a stolen/intercepted signed quote cannot be redeemed by
+        // someone else.
+        require!(
+            quote.buyer == *ctx.accounts.buyer.key(),
+            NimbusError::Unauthorized
+        );
+
         let now = Clock::get()?.unix_timestamp;
         require!(quote.quote_expiry_unix >= now, NimbusError::QuoteExpired);
         require!(quote.premium_amount > 0, NimbusError::InvalidBps);
