diff --git a/lib/pricing.ts b/lib/pricing.ts
new file mode 100644
index 0000000..b1eafae
--- /dev/null
+++ b/lib/pricing.ts
@@ -0,0 +1,47 @@
+// Shared server-side pricing model for the quote flow.
+//
+// Single source of truth used by BOTH:
+//   - /api/quotes/calculate  (displays the premium)
+//   - /api/quotes/sign       (recomputes the fair premium and rejects underpayment)
+//
+// Keeping the pricing in one module guarantees the displayed price and the signed
+// price can never drift apart. See docs/SECURITY_REVIEW_RESPONSE.md ("Finding 1").
+//
+// NOTE: this is the MVP flat model (payout × 3.5% pure + 1% surcharge + 5% fee).
+// The on-chain `risk.rs` dynamic-LTV / utilization-surcharge model should replace
+// it before any mainnet deployment.
+
+export const MAX_PAYOUT_DOLLARS = 1_000_000
+
+export interface PremiumBreakdown {
+  purePremium: number
+  utilizationSurcharge: number
+  protocolFee: number
+}
+
+export interface QuotePrice {
+  premium: number // whole USDC dollars (always an integer — components are floored)
+  premiumAmount: number // same value, kept for backward compatibility
+  breakdown: PremiumBreakdown
+  quoteValiditySecs: number
+}
+
+export function computePremium(payoutDollars: number): QuotePrice {
+  // Mirrors the original /api/quotes/calculate formula. Floors each component at
+  // the whole-dollar level, so `premium` is always an integer number of dollars.
+  const purePremium = Math.floor(payoutDollars * 0.035)
+  const surcharge = Math.floor(payoutDollars * 0.01)
+  const fee = Math.floor((purePremium + surcharge) * 0.05)
+  const total = purePremium + surcharge + fee
+
+  return {
+    premium: total,
+    premiumAmount: total,
+    breakdown: {
+      purePremium,
+      utilizationSurcharge: surcharge,
+      protocolFee: fee,
+    },
+    quoteValiditySecs: 120,
+  }
+}
diff --git a/lib/quote.ts b/lib/quote.ts
new file mode 100644
index 0000000..14ee178
--- /dev/null
+++ b/lib/quote.ts
@@ -0,0 +1,68 @@
+// Borsh-compatible serialization of the on-chain `Quote` struct.
+//
+// Field order and types MUST match `programs/nimbus/src/state.rs` (`Quote`) and
+// what Anchor's `Quote::try_to_vec()` produces: little-endian integers, single-byte
+// enum discriminants, no length prefixes.
+//
+// This module is shared by the quote-signing API (server) and the client, so the
+// message the server signs is guaranteed to be the same bytes the on-chain program
+// re-serializes during Ed25519 verification.
+
+import { Buffer } from 'buffer'
+
+export type Peril = 0 | 1 | 2
+export type IndexMethod = 0 | 1 | 2
+export type Direction = 0 | 1
+
+export interface QuoteFields {
+  policyId: bigint
+  /** 32-byte buyer public key — binds the quote to a specific wallet. */
+  buyer: Uint8Array
+  poolId: bigint
+  regionId: bigint
+  peril: Peril
+  windowStartUnix: bigint
+  windowEndUnix: bigint
+  indexMethod: IndexMethod
+  direction: Direction
+  threshold: bigint
+  payoutAmount: bigint
+  premiumAmount: bigint
+  quoteExpiryUnix: bigint
+  nonce: bigint
+}
+
+function u64(value: bigint): Buffer {
+  const buf = Buffer.alloc(8)
+  buf.writeBigUInt64LE(value)
+  return buf
+}
+
+function i64(value: bigint): Buffer {
+  const buf = Buffer.alloc(8)
+  buf.writeBigInt64LE(value)
+  return buf
+}
+
+export function serializeQuote(quote: QuoteFields): Buffer {
+  return Buffer.concat([
+    u64(quote.policyId),
+    Buffer.from(quote.buyer), // 32-byte buyer pubkey (account binding)
+    u64(quote.poolId),
+    u64(quote.regionId),
+    Buffer.from([quote.peril]),
+    i64(quote.windowStartUnix),
+    i64(quote.windowEndUnix),
+    Buffer.from([quote.indexMethod]),
+    Buffer.from([quote.direction]),
+    i64(quote.threshold),
+    u64(quote.payoutAmount),
+    u64(quote.premiumAmount),
+    i64(quote.quoteExpiryUnix),
+    u64(quote.nonce),
+  ])
+}
+
+export function toBigInt(value: string | number | bigint): bigint {
+  return typeof value === 'bigint' ? value : BigInt(value)
+}
